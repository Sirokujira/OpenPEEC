node = 12 0.2 0.025 0
node = 13 0.2 0.05 0
node = 14 0.2 0.075 0
node = 15 0.2 0.1 0
node = 16 0.2 0.125 0
node = 17 0.2 0.15 0
node = 18 0.2 0.175 0
node = 19 0.2 0.2 0
plate = 0 0 0  0.2 0 0  0 0.2 0  1e-4 5.8e7 8 8
resistor = 1 2 1e-9
resistor = 2 3 1e-9
resistor = 3 4 1e-9
resistor = 4 5 1e-9
resistor = 5 6 1e-9
resistor = 6 7 1e-9
