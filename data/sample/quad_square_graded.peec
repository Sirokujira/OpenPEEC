# 検証 (ap) : 面格子のグレーディング (grading = 1) — 縁寄せ格子の quad
#   quad_square.peec と同じ 0.2 m 角シート (8x8 分割) を grading = 1 で解く。
#   格子点はパラメータ空間の余弦分布 y_i = 0.1 (1 - cos(pi i/8)) に移るので、
#   バス (微小抵抗の短絡) のノード座標も同じ式で置いてある (nodetol 1e-8 の
#   マージが効くよう 16 桁で記載。libm の cos との差は ~1e-17 m)。
#
#   判定 :
#   - DC 抵抗 = 1.724138e-4 ohm (1 スクエア、厳密)。双対幅を格子座標の
#     隣接中点から導いているので、非一様格子でも矩形格子なら厳密に保たれる
#     ことの番人。縁寄せでバスとの接続が外れると +46% ずれるので、
#     格子点の生成式とこのファイルの座標の食い違いも同時に検出する。
#   - L を plate 版 (スクリプトが quad 行を plate 行に差し替えて生成する
#     別経路の実装) と比較 (許容 0.1%、実測 1e-5 レベル)。グレーディングが
#     多角形経路と矩形リボン経路で同一の格子を作ることの番人。
OpenPEEC 1 0
title = square sheet with graded grid (quad panel)
grading = 1
node = 1 0 0 0
node = 2 0 0.007612046748871327 0
node = 3 0 0.02928932188134524 0
node = 4 0 0.06173165676349102 0
node = 5 0 0.09999999999999999 0
node = 6 0 0.138268343236509 0
node = 7 0 0.1707106781186548 0
node = 8 0 0.1923879532511287 0
node = 9 0 0.2 0
node = 11 0.2 0 0
node = 12 0.2 0.007612046748871327 0
node = 13 0.2 0.02928932188134524 0
node = 14 0.2 0.06173165676349102 0
node = 15 0.2 0.09999999999999999 0
node = 16 0.2 0.138268343236509 0
node = 17 0.2 0.1707106781186548 0
node = 18 0.2 0.1923879532511287 0
node = 19 0.2 0.2 0
quad = 0 0 0  0.2 0 0  0.2 0.2 0  0 0.2 0  1e-4 5.8e7 8 8
resistor = 1 2 1e-9
resistor = 2 3 1e-9
resistor = 3 4 1e-9
resistor = 4 5 1e-9
resistor = 5 6 1e-9
resistor = 6 7 1e-9
resistor = 7 8 1e-9
resistor = 8 9 1e-9
resistor = 11 12 1e-9
resistor = 12 13 1e-9
resistor = 13 14 1e-9
resistor = 14 15 1e-9
resistor = 15 16 1e-9
resistor = 16 17 1e-9
resistor = 17 18 1e-9
resistor = 18 19 1e-9
port = 5 15 50
frequency = 10 10 0
end
