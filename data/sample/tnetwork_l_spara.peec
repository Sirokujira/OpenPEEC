# 検証 : 2 ポート S パラメータ (リアクタンスを含む T 型回路)
#
# 目的
#   tnetwork_spara.peec は全実数なので、Z -> S 変換の複素数経路が通らない。
#   直列腕をインダクタにして S を複素数にし、厳密解と比較する。
#   非対称 (S11 != S22) だが相反 (S12 = S21) な回路なので、その両方を判定できる。
#
# 回路
#   port#1 = node 1 - GND,  port#2 = node 2 - GND,  Z0 = 50 ohm (両ポート)
#
#     node1 --[L1=1uH]-- node3 --[R2=25]-- node2
#                          |
#                        [R3=50]
#                          |
#                         GND
#
# 周波数は wL = 50 ohm ちょうどになる点を選ぶ
#   f = 50 / (2 pi * 1e-6) = 7.9577471546e6 Hz
#
# 厳密解
#   Z = [[jwL + R3, R3], [R3, R2 + R3]] = [[50 + j50, 50], [50, 75]]  [ohm]
#
#   Z - Z0 I = [[j50, 50], [50, 25]]
#   Z + Z0 I = [[100 + j50, 50], [50, 125]]
#   det(Z + Z0 I) = 125(100 + j50) - 2500 = 10000 + j6250
#   |det|^2 = 10000^2 + 6250^2 = 139062500
#
#   S11 = (-2500 + j6250) / (10000 + j6250) = 0.101123595 + j0.561797753
#   S21 = S12 =      5000 / (10000 + j6250) = 0.359550562 - j0.224719101
#   S22 =         j1250    / (10000 + j6250) = 0.056179775 + j0.089887640
#
#   |S11| = 0.571, |S21| = 0.424, |S22| = 0.106
#
OpenPEEC 1 0
title = T network with series L : 2-port S parameters

inductor = L1 1 3 1e-6
resistor = 3 2 25
resistor = 3 0 50

port = 1 0 50
port = 2 0 50

frequency = 7.9577471546e6 7.9577471546e6 0
end
